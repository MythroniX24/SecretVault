<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <View android:id="@+id/topAccent" android:layout_width="0dp" android:layout_height="4dp"
        android:background="?attr/colorPrimary"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.core.widget.NestedScrollView android:layout_width="0dp" android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/topAccent" app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingHorizontal="28dp"
            android:paddingTop="48dp" android:paddingBottom="40dp" android:gravity="center_horizontal">

            <!-- Icon -->
            <com.google.android.material.card.MaterialCardView android:layout_width="96dp"
                android:layout_height="96dp" app:cardCornerRadius="28dp"
                app:cardBackgroundColor="?attr/colorPrimaryContainer" app:cardElevation="0dp">
                <ImageView android:layout_width="48dp" android:layout_height="48dp"
                    android:layout_gravity="center" android:src="@drawable/ic_vault"
                    android:tint="?attr/colorOnPrimaryContainer"/>
            </com.google.android.material.card.MaterialCardView>

            <TextView android:id="@+id/tvLockTitle" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Unlock Vault"
                android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
                android:textColor="?attr/colorOnSurface" android:layout_marginTop="20dp"/>

            <TextView android:id="@+id/tvLockSubtitle" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Use your biometric to access your vault"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" android:gravity="center"
                android:layout_marginTop="8dp" android:layout_marginBottom="32dp"/>

            <!-- Biometric Section -->
            <LinearLayout android:id="@+id/layoutBiometric" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:gravity="center" android:visibility="gone">
                <com.google.android.material.card.MaterialCardView android:layout_width="84dp"
                    android:layout_height="84dp" app:cardCornerRadius="42dp"
                    app:cardBackgroundColor="?attr/colorSurfaceVariant" app:cardElevation="0dp">
                    <ImageView android:layout_width="44dp" android:layout_height="44dp"
                        android:layout_gravity="center" android:src="@drawable/ic_fingerprint"
                        android:tint="?attr/colorPrimary"/>
                </com.google.android.material.card.MaterialCardView>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Touch sensor to unlock" android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" android:layout_marginTop="10dp"
                    android:layout_marginBottom="8dp"/>
            </LinearLayout>

            <!-- Master Password Section -->
            <LinearLayout android:id="@+id/layoutMasterPassword" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilMasterPassword"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Master Password" app:startIconDrawable="@drawable/ic_key"
                    app:endIconMode="password_toggle">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etMasterPassword"
                        android:importantForAutofill="no"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="textPassword" android:imeOptions="actionNext"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Strength meter — 5 segment bars (first-time setup only) -->
                <LinearLayout android:id="@+id/layoutStrength" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical"
                    android:layout_marginTop="4dp" android:layout_marginBottom="4dp"
                    android:visibility="gone">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="8dp"
                        android:orientation="horizontal" android:weightSum="5">
                        <View android:id="@+id/bar1" android:layout_width="0dp" android:layout_height="match_parent"
                            android:layout_weight="1" android:layout_marginEnd="3dp" android:background="#E0E0E0"/>
                        <View android:id="@+id/bar2" android:layout_width="0dp" android:layout_height="match_parent"
                            android:layout_weight="1" android:layout_marginEnd="3dp" android:background="#E0E0E0"/>
                        <View android:id="@+id/bar3" android:layout_width="0dp" android:layout_height="match_parent"
                            android:layout_weight="1" android:layout_marginEnd="3dp" android:background="#E0E0E0"/>
                        <View android:id="@+id/bar4" android:layout_width="0dp" android:layout_height="match_parent"
                            android:layout_weight="1" android:layout_marginEnd="3dp" android:background="#E0E0E0"/>
                        <View android:id="@+id/bar5" android:layout_width="0dp" android:layout_height="match_parent"
                            android:layout_weight="1" android:background="#E0E0E0"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginTop="4dp">
                        <TextView android:id="@+id/tvStrengthLabel" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:textSize="12sp"
                            android:textStyle="bold" android:text=""/>
                        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>
                        <TextView android:id="@+id/tvStrengthTip" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:textSize="11sp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:maxLines="1" android:ellipsize="end" android:text=""/>
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilConfirmMasterPw"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Confirm Master Password" android:layout_marginTop="12dp"
                    android:visibility="gone" app:startIconDrawable="@drawable/ic_key"
                    app:endIconMode="password_toggle">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etConfirmMasterPassword"
                        android:importantForAutofill="no"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="textPassword" android:imeOptions="actionDone"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton android:id="@+id/btnUnlockPassword"
                    android:layout_width="match_parent" android:layout_height="56dp"
                    android:text="Unlock" android:layout_marginTop="20dp" app:cornerRadius="14dp"/>
            </LinearLayout>

            <!-- Unlock options row -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center" android:layout_marginTop="12dp">

                <TextView android:id="@+id/tvUseMasterPassword" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Master Password"
                    android:textColor="?attr/colorPrimary" android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:padding="10dp" android:visibility="gone"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text=" · " android:textColor="?attr/colorOnSurfaceVariant" android:id="@+id/tvDivider"
                    android:visibility="gone"/>

                <com.google.android.material.button.MaterialButton android:id="@+id/btnUnlockPin"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content" android:layout_height="40dp"
                    android:text="Use PIN" android:textSize="13sp"
                    android:visibility="gone" app:icon="@drawable/ic_security" app:iconSize="16dp"/>
            </LinearLayout>

            <ProgressBar android:id="@+id/progressBar" android:layout_width="36dp"
                android:layout_height="36dp" android:layout_marginTop="16dp" android:visibility="gone"/>

            <com.google.android.material.chip.Chip android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Argon2id · AES-256-GCM · HMAC-SHA256"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                android:layout_marginTop="40dp" android:checkable="false"
                app:chipBackgroundColor="?attr/colorSurfaceVariant"
                app:chipIcon="@drawable/ic_lock" app:chipIconTint="?attr/colorPrimary"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
